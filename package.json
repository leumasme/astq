{
    "name": "astq",
    "version": "2.8.1",
    "description": "Abstract Syntax Tree (AST) Query Engine",
    "keywords": ["abstract", "syntax", "tree", "query", "engine", "adaptable"],
    "license": "MIT",
    "type": "module",
    "main": "dist/astq.js",
    "module": "dist/astq.js",
    "types": "dist/astq.d.ts",
    "browser": "dist/astq.browser.js",
    "exports": {
        ".": {
            "types": "./dist/astq.d.ts",
            "browser": "./dist/astq.browser.js",
            "import": "./dist/astq.js",
            "require": "./dist/astq.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rse/astq.git"
    },
    "author": {
        "name": "Dr. Ralf S. Engelschall",
        "email": "rse@engelschall.com",
        "url": "http://engelschall.com"
    },
    "homepage": "https://github.com/rse/astq",
    "bugs": "https://github.com/rse/astq/issues",
    "dependencies": {
        "peggy": "4.0.2",
        "pegjs-otf": "2.0.2",
        "pegjs-util": "2.0.1",
        "asty": "1.8.21",
        "cache-lru": "1.2.0"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "typescript": "^5.5.3",
        "tsup": "^8.1.0",
        "eslint": "^8.57.0",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "mocha": "^10.5.2",
        "chai": "^5.1.1",
        "@types/chai": "^4.3.16",
        "@types/mocha": "^10.0.7",
        "js-yaml": "^4.1.0",
        "@types/js-yaml": "^4.0.9"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "mocha tst/astq.js",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build && npm run test"
    }
}
